# コピーして terraform.tfvars を作り、自分の値に置き換える（terraform.tfvars は Git 管理外）。
# ここにはダミー値だけを書く。実アカウント ID や実 IP をこのファイルに書かない。

allowed_account_id  = "111122223333"
admin_principal_arn = "arn:aws:iam::111122223333:user/example-admin"

# 自分のグローバル IP の /32 だけ。0.0.0.0/0 は受け付けない。
public_access_cidrs = ["203.0.113.10/32"]

# region             = "ap-northeast-1"
# single_nat_gateway = true
# node_desired_size  = 2
# cluster_log_types  = []
